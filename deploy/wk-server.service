[Unit]
Description=Hour Record API (工时记录后端)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/wk-server
EnvironmentFile=/opt/wk-server/env
ExecStart=/opt/wk-server/wk-server
Restart=always
RestartSec=3

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/wk-server

[Install]
WantedBy=multi-user.target
