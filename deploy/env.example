# 复制为服务器上的 /opt/wk-server/env 并填入真实值（此文件不要提交真实密钥到 Git）

# MySQL 连接（服务器上创建的用户密码，替换 YOUR_STRONG_PASSWORD）
MYSQL_DSN=hourrec:YOUR_STRONG_PASSWORD@tcp(127.0.0.1:3306)/worktime?charset=utf8mb4&loc=Local

# 微信小程序（与 start.sh 中相同，正式发布建议重置 AppSecret）
WX_APPID=wx3c1dd870d0d09efa
WX_SECRET=你的AppSecret

# 监听地址（保持默认，由 Caddy 反代对外）
ADDR=0.0.0.0:8080
